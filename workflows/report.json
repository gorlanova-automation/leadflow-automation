      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT count(*)::int AS total,count(*) FILTER (WHERE deal_id IS NOT NULL)::int AS created,count(*) FILTER(WHERE state='complete')::int AS complete,count(*) FILTER(WHERE state='crm_review')::int AS crm_review,count(*) FILTER(WHERE state='notification_failed')::int AS notification_failed FROM auto01.requests WHERE created_at>=now()-interval '24 hours';",
        "options": {
          "queryReplacement": "={{ [] }}"
        }
      },
