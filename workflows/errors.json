        "postgres": {
          "id": "CONFIGURE_POSTGRES",
          "name": "Назначить свой доступ"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO auto01.audit(execution_id,event,severity,step,code,details)\nVALUES($1,CASE WHEN $2 THEN 'alert_sent' ELSE 'alert_failed' END,CASE WHEN $2 THEN 'INFO' ELSE 'ERROR' END,\n'alert',CASE WHEN $2 THEN 'ok' ELSE 'delivery_not_confirmed' END,jsonb_build_object('message_id',$3::bigint)) RETURNING id;",
        "options": {
          "queryReplacement": "={{ [String($('Ошибка выполнения').item.json.execution?.id||'activation'),!!($json.ok && $json.result?.message_id),$json.result?.message_id||null] }}"
        }
      },
      "onError": "continueRegularOutput"
    }
