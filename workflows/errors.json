      },
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO auto01.audit(execution_id,event,severity,step,code,details)\nVALUES($1,'unhandled_error','ERROR',$2,'workflow_failed',jsonb_build_object('workflow_id',$3::text)) RETURNING id;",
        "options": {
          "queryReplacement": "={{ [String($json.execution?.id||'activation'),$json.execution?.lastNodeExecuted||'activation',$json.workflow?.id||'unknown'] }}"
        }
      },
      "onError": "continueRegularOutput"
    },
